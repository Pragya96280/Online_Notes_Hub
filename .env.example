# MongoDB Atlas connection string. Replace <db_password> with your database user's password.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/notes_hub?retryWrites=true&w=majority

# Generate a long random secret (at least 32 characters).
JWT_SECRET=replace_this_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development

# Optional: override the local demo accounts created by `npm run seed:demo`.
# In production these four values are required before running the seed command.
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
